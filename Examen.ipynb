    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "meses = [\"Ene\", \"Feb\", \"Mar\", \"Abr\", \"May\", \"Jun\",\n",
    "         \"Jul\", \"Ago\", \"Sep\", \"Oct\", \"Nov\", \"Dic\"]\n",
    "np.random.seed(0)\n",
    "y_facebook = np.random.randint(0, 101, size=12)\n",
    "y_twitter  = np.random.randint(0, 101, size=12)\n",
    "y_instagram= np.random.randint(0, 101, size=12)\n",
    "\n",
    "plt.figure(figsize=(8,4))\n",
    "plt.plot(meses, y_facebook,   marker='o', label='Facebook')\n",
    "plt.plot(meses, y_twitter,    marker='s', label='Twitter')\n",
    "plt.plot(meses, y_instagram,  marker='^', label='Instagram')\n",
    "\n",
    "\n",
    "plt.ylabel('Número de interacciones')\n",
    "plt.legend()\n",
    "\n",
    "idx = np.argmax(y_instagram)\n",
    "plt.annotate(\n",
    "    'Pico Instagram',\n",
    "    xy=(meses[idx], y_instagram[idx]),\n",
    "    xytext=(idx, y_instagram[idx]+10),\n",
    "    arrowprops=dict(arrowstyle='->')\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
